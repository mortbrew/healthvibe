# Placeholder settings for the container. Copy to .env (gitignored).
# Do not put real secrets or health data in this file.
# Compose mounts ./appdata at /data and publishes no host ports.

HEALTHVIBE_DATABASE_URL=sqlite:////data/healthvibe.db
HEALTHVIBE_DATA_DIR=/data
HEALTHVIBE_SECRET_KEY=replace-with-a-long-random-string
HEALTHVIBE_DEBUG=false
HEALTHVIBE_HOST=0.0.0.0
HEALTHVIBE_PORT=8000
