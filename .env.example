# =============================================================================
# healthvibe settings
# -----------------------------------------------------------------------------
# Copy this file to .env in /opt/stacks/healthvibe and edit it:
#     cp .env.example .env && chmod 600 .env
# Lines starting with # are comments. Values have no quotes.
# Real secrets and health data never go in git; .env is git-ignored.
# =============================================================================

# --- Network -----------------------------------------------------------------
# Name of the Docker network your reverse proxy is on. healthvibe joins it so
# the proxy can reach http://healthvibe:8000. Must already exist
# (docker network create proxy).
HEALTHVIBE_PROXY_NETWORK=proxy

# Address the app listens on INSIDE the container. Leave as is.
HEALTHVIBE_BIND=0.0.0.0:8000

# --- Storage (paths inside the container; ./appdata on the host is /data) ----
# Where the SQLite database lives  -> ./appdata/db/healthvibe.db
HEALTHVIBE_DB_DIR=/data/db
# Where uploads wait while being imported -> ./appdata/staging
# Uploaded zips are deleted as soon as the import finishes.
HEALTHVIBE_STAGING_DIR=/data/staging

# --- iPhone sync (Health Auto Export) -----------------------------------------
# The public HTTPS address of healthvibe, as your iPhone reaches it through
# your reverse proxy. It is shown in the Health Auto Export setup steps.
# No trailing slash.
HEALTHVIBE_PUBLIC_URL=https://health.example.com
# Largest single Shortcut upload in bytes (5 MiB).
HEALTHVIBE_MAX_REQUEST_BYTES=5242880
# Largest single Health Auto Export upload in bytes (256 MiB). Turn on
# "Batch Requests" in the app so big history exports arrive in pieces.
HEALTHVIBE_HAE_MAX_REQUEST_BYTES=268435456

# --- Hardening -----------------------------------------------------------------
# Keep the container's own filesystem read-only (recommended: true).
HEALTHVIBE_READ_ONLY_ROOTFS=true

# Login cookies are normally sent only over HTTPS (your reverse proxy).
# Set to true ONLY when testing over plain http://127.0.0.1:8000.
HEALTHVIBE_ALLOW_HTTP=false

# --- Logging -------------------------------------------------------------------
# How chatty the logs are: error, warn, info, debug. Health values and
# passwords are never logged.
RUST_LOG=info
